        },
        {
          "widget": {
            "name": "heatmap_tech",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_tech", "fields": [
              {"name": "theme", "expression": "`theme`"},
              {"name": "brand", "expression": "`brand`"},
              {"name": "sum(share_of_pages)", "expression": "SUM(`share_of_pages`)"}
            ], "disaggregated": false}}],
            "spec": {
              "version": 3,
              "widgetType": "heatmap",
              "encodings": {
                "x": {
                  "fieldName": "theme",
                  "displayName": "Theme",
                  "scale": {
                    "type": "categorical",
                    "sort": {"by": "custom-order", "orderedValues": [
                      "Electric & Battery", "Autonomy", "Telematics & Connectivity", "GPS & Precision",
                      "Alternative Fuels", "Emissions", "Sustainability"
                    ]}
                  },
                  "axis": {"hideTitle": true}
                },
                "y": {"fieldName": "brand", "displayName": "Company", "scale": {"type": "categorical"}, "axis": {"hideTitle": true}},
                "color": {
                  "fieldName": "sum(share_of_pages)",
                  "displayName": "Pages mentioning the theme",
                  "scale": {"type": "quantitative", "colorRamp": {"mode": "custom-sequential", "colors": {"start": "#FCEBDD", "end": "#D55E00"}}},
                  "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 0}}
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Technology focus",
                "showDescription": true,
                "description": "Share of each company's scraped pages that mention the theme. Companies whose pages have too little text are not shown."
              }
            }
          },
          "position": {"x": 5, "y": 22, "width": 7, "height": 7}
        },
        {
          "widget": {
            "name": "line_news",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_news", "fields": [
              {"name": "year_start", "expression": "`year_start`"},
              {"name": "brand", "expression": "`brand`"},
              {"name": "sum(news_pages)", "expression": "SUM(`news_pages`)"}
            ], "disaggregated": false}}],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "year_start", "displayName": "Year", "scale": {"type": "temporal"}, "axis": {"hideTitle": true}},
                "y": {"fieldName": "sum(news_pages)", "displayName": "News pages", "scale": {"type": "quantitative"}},
                "color": {"fieldName": "brand", "displayName": "Company", "scale": {"type": "categorical"}}
              },
              "frame": {
                "showTitle": true,
                "title": "News activity per year",
                "showDescription": true,
                "description": "News pages per year, from the year in each news page address. Companies without dated news addresses are not shown."
              }
            }
          },
          "position": {"x": 0, "y": 29, "width": 8, "height": 6}
        },
        {
          "widget": {
            "name": "notes",
            "multilineTextboxSpec": {
              "lines": [
                "### About this data\n",
                "\n",
                "All values come from each company's US website, scraped by the equipment_companies_pipeline job. ",
                "Some websites block automated visits or build their pages with JavaScript, so those companies have partial or no data. The **Website data** column in the company directory says which.\n",
                "\n",
                "Counts reflect pages published on each website, not sales or the number of models in production."
              ]
            }
          },
          "position": {"x": 8, "y": 29, "width": 4, "height": 6}
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {"light": "#F7F8FA", "dark": "#1F272D"},
      "widgetBackgroundColor": {"light": "#FFFFFF", "dark": "#11171C"},
      "fontColor": {"light": "#11171C", "dark": "#E8ECF0"},
      "selectionColor": {"light": "#2272B4", "dark": "#8ACAFF"},
      "visualizationColors": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#D55E00", "#56B4E9", "#F0E442", "#999999"],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}
